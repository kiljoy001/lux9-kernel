#!/boot/sophia

# Lux9 WASM Test Init Script
# Runs comprehensive WASM tests and reports results

print "========================================\n"
print "WASM TEST SUITE - Starting Tests\n"
print "========================================\n"

# Test 1: Check if WASM device exists
print "\n[TEST 1] Checking WASM device...\n"
if (open "/dev/wasm" "r") {
    print "✓ WASM device exists\n"
    close
} else {
    print "✗ WASM device not found\n"
}

# Test 2: Try to read WASM test file
print "\n[TEST 2] Checking WASM test files...\n"
if (open "/boot/hello.wasm" "r") {
    print "✓ hello.wasm found\n"
    close
} else {
    print "✗ hello.wasm not found\n"
}

if (open "/boot/extensive_test.wasm" "r") {
    print "✓ extensive_test.wasm found\n"
    close
} else {
    print "✗ extensive_test.wasm not found\n"
}

# Test 3: Execute WASM test program
print "\n[TEST 3] Executing exec_wasm test...\n"
print "Attempting to run: /boot/exec_wasm\n"

# This will try to exec a WASM module
# exec "/boot/exec_wasm"

print "\n========================================\n"
print "WASM TEST SUITE - Tests Complete\n"
print "========================================\n"
print "System ready for interactive testing\n"

# Keep running so we can see results
sleep 30
