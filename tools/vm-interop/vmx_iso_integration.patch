@@ -588,6 +592,8 @@ threadmain(int argc, char **argv)
 	static int edevn;
 	static uvlong gmemsz = 64*1024*1024;
 	static char *srvname;
+	static char *isofile = nil;
+	static int isoboot = 0;
 	extern uintptr fbsz, fbaddr;
 	int newwin = 0;
 	int i;
@@ -632,6 +638,18 @@ threadmain(int argc, char **argv)
 		}
 		edevn++;
 		break;
+	case 'i':
+		isofile = strdup(EARGF(usage()));
+		isoboot = 1;
+		/* Add ISO as IDE CDROM */
+		assert(edevn < nelem(edev));
+		edevaux[edevn] = smprint("ide:%s", isofile);
+		edev[edevn] = mkideblk;
+		edevt[edevn] = "ide cdrom";
