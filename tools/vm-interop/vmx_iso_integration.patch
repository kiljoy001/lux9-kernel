@@ -655,8 +673,31 @@ threadmain(int argc, char **argv)
 	default:
 		usage();
 	} ARGEND;
-	if(argc < 1) usage();
-	cmdlinen = argc - 1;
+	
+	/* Handle ISO boot */
+	if(isoboot && isofile != nil){
+		void *kernel;
+		long kernsize;
+		char tmpfile[256];
+		int fd;
+		
+		print("Booting from ISO: %s\n", isofile);
+		kernel = vmx_boot_iso(isofile, &kernsize);
+		if(kernel == nil)
+			sysfatal("cannot boot from ISO: %r");
+		
+		/* Write kernel to temp file */
+		snprint(tmpfile, sizeof(tmpfile), "/tmp/vmx_kernel.%d", getpid());
+		fd = create(tmpfile, OWRITE|ORCLOSE, 0600);
+		if(fd < 0 || write(fd, kernel, kernsize) != kernsize)
+			sysfatal("cannot write temp kernel: %r");
+		close(fd);
+		free(kernel);
+		
+		/* Set kernel argument */
+		argv[0] = tmpfile;
+		cmdlinen = 0;
+	} else if(argc < 1)
+		usage();
 	cmdlinev = argv + 1;
 	
