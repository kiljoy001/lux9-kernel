#!/bin/rc
# Bridge between mounted filesystem and cmdexec synthetic files
# Run this in the VM to connect file-based commands to cmdexec

while(sleep 1){
    # Check for command
    if(test -f /n/interop/cmd.txt && test -s /n/interop/cmd.txt){
        cmd=`{cat /n/interop/cmd.txt}

        # Send to cmdexec
        echo $cmd >/n/cmdexec/exec

        # Clear command file
        >/n/interop/cmd.txt

        # Get output from cmdexec
        out=`{cat /n/cmdexec/output}

        # Write to output file
        echo $out >/n/interop/out.txt
    }
}
