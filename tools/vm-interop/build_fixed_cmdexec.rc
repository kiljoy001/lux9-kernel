#!/bin/rc
# Compile the fixed cmdexec.c on the host first

echo 'Compiling fixed cmdexec.c...'

# Use the Plan 9 C compiler (6c for amd64)
cd /home/scott/Repo/VM-Interop

# Compile with Plan 9 C compiler
6c -FTVw cmdexec.c
if(! ~ $status ''){
	echo 'Compilation failed!'
	exit 1
}

# Link
6l -o cmdexec cmdexec.6
if(! ~ $status ''){
	echo 'Linking failed!' 
	exit 1
}

echo 'Build successful! Binary: cmdexec'
ls -la cmdexec