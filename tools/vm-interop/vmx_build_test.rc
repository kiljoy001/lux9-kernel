#!/bin/rc
# Quick VMX build test script

echo "=== VMX ISO Boot Support Build Test ==="
echo ""

# First copy the files from interop to VMX source
echo "Copying files to VMX source..."
cp /n/interop/seabios_eltorito.c /sys/src/cmd/vmx/
cp /n/interop/vmx.c /sys/src/cmd/vmx/
cp /n/interop/mkfile /sys/src/cmd/vmx/

cd /sys/src/cmd/vmx
echo "Current directory: " `{pwd}

echo ""
echo "Files in VMX directory:"
ls *.c

echo ""
echo "=== Building VMX ==="
mk clean
mk

echo ""
echo "=== Checking VMX binary ==="
if(test -f vmx){
    echo "VMX binary built successfully"
    echo ""
    echo "=== Testing -i flag ==="
    ./vmx -h
}
if not {
    echo "VMX build failed"
}