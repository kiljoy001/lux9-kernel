--- ide.c.orig	2025-01-09
+++ ide.c	2025-01-09
@@ -450,3 +450,31 @@
 	ideattach(aux);
 	return 0;
 }
+
+int
+mkidecd(char *fn)
+{
+	int fd;
+	Dir *d;
+	Ctlr *c;
+	Drive *dr;
+	
+	fd = open(fn, OREAD);
+	if(fd < 0) return -1;
+	d = dirfstat(fd);
+	if(d == nil){
+		close(fd);
+		return -1;
+	}
+	
+	c = idectlr;
+	dr = &c->drive[c->ndrive++];
+	dr->fd = fd;
+	dr->sz = d->length;
+	dr->atapi = 1;  /* Mark as ATAPI CD-ROM */
+	dr->mediatype = 0x05; /* CD-ROM */
+	free(d);
+	
+	ideattach(fn);
+	return 0;
+}