#!/bin/rc
# Build and test VMX with ISO support

echo "=== Building VMX with SeaBIOS ISO support ==="

# Copy updated files to VMX source directory
cp /n/interop/vmx.c /sys/src/cmd/vmx/
cp /n/interop/mkfile /sys/src/cmd/vmx/  
cp /n/interop/seabios_eltorito.c /sys/src/cmd/vmx/

# Navigate to VMX directory
cd /sys/src/cmd/vmx

echo "Current directory: " `{pwd}
echo "Files in VMX directory:"
ls

echo "=== Building VMX ==="
mk clean
mk

echo "=== Testing VMX with ISO support ==="
# Test if VMX recognizes the -i flag
./vmx

echo "=== Build and test complete ==="