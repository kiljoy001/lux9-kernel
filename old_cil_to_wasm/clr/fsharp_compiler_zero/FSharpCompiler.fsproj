<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.8.400" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FSharpAST.fs" />
    <!-- Deprecated: <Compile Include="FSharpLexer.fs" /> -->
    <!-- Deprecated: <Compile Include="FSharpParser.fs" /> -->
    <Compile Include="FSharpExhaustiveness.fs" />
    <Compile Include="FSharpModuleSystem.fs" />
    <Compile Include="FSharpHindleyMilner.fs" />
    <Compile Include="FSharpTypeInference.fs" />
    <Compile Include="FSharpToIL.fs" />
    <Compile Include="PEWriter.fs" />
    <Compile Include="FSharpCodeGen.fs" />
    <Compile Include="SafeCodeGen.fs" />
    <Compile Include="FSharpCompiler.fs" />
  </ItemGroup>

</Project>