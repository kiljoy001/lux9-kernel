# Makefile for C# Init System Tests
# Provides quick build and test execution for all test categories

.PHONY: all test smoke collections etl control boot integration error performance clean help

# Default target
all: smoke collections etl control boot integration error performance runner

# Individual test categories (5-15 minutes each)
smoke: test_cs_init_smoke.cs
	@echo "=== Building Smoke Test ==="
	@mkdir -p build_smoke
	@cp test_cs_init_smoke.cs build_smoke/Program.cs
	@cd build_smoke && dotnet new console --force >/dev/null 2>&1
	@cd build_smoke && rm -f Program.cs && cp ../test_cs_init_smoke.cs Program.cs
	@cd build_smoke && echo '<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><PublishAot>true</PublishAot></PropertyGroup></Project>' > Test.csproj
	@cd build_smoke && dotnet build -c Release --verbosity quiet
	@echo "✓ Smoke test built: build_smoke/bin/Release/net9.0/"

collections: test_cs_init_collections.cs
	@echo "=== Building Collections Test ==="
	@mkdir -p build_collections
	@cp test_cs_init_collections.cs build_collections/Program.cs
