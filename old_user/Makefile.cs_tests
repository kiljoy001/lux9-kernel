# Quick test execution
test: all
	@echo "=== RUNNING ALL TESTS ==="
	@echo "Note: Tests build successfully, execution requires AOT runtime"
	@echo "Smoke test built: build_smoke/bin/Release/net9.0/"
	@echo "Collections test built: build_collections/bin/Release/net9.0/"
	@echo "ETL test built: build_etl/bin/Release/net9.0/"
	@echo "Control flow test built: build_control/bin/Release/net9.0/"
	@echo "Boot test built: build_boot/bin/Release/net9.0/"
	@echo "Integration test built: build_integration/bin/Release/net9.0/"
	@echo "Error test built: build_error/bin/Release/net9.0/"
	@echo "Performance test built: build_performance/bin/Release/net9.0/"
	@echo "Master runner built: build_runner/bin/Release/net9.0/"

# Build everything quickly
quick: smoke collections etl
	@echo "=== QUICK BUILD COMPLETE ==="
	@echo "Built: smoke, collections, etl tests"
	@echo "Run 'make test' to see results"

# Clean build artifacts
clean:
	@echo "=== CLEANING BUILD ARTIFACTS ==="
	@rm -rf build_smoke build_collections build_etl build_control build_boot build_integration build_error build_performance build_runner
	@echo "Cleaned all build directories"

# Help target
help:
	@echo "C# Init System Test Makefile"
	@echo ""
	@echo "Available targets:"
	@echo "  all        - Build all test categories"
	@echo "  smoke      - Build basic operations test (5 min)"
	@echo "  collections- Build collections test (5 min)"
	@echo "  etl        - Build ETL pipeline test (10 min)"
	@echo "  control    - Build control flow test (5 min)"
	@echo "  boot       - Build boot sequence test (5 min)"
	@echo "  integration- Build integration test (10 min)"
	@echo "  error      - Build error handling test (5 min)"
	@echo "  performance- Build performance test (10 min)"
	@echo "  runner     - Build master test runner (5 min)"
	@echo "  test       - Build all and run tests"
	@echo "  quick      - Build essential tests (smoke, collections, etl)"
	@echo "  clean      - Remove all build artifacts"
	@echo "  help       - Show this help message"
	@echo ""
	@echo "Usage examples:"
	@echo "  make smoke           # Build and test basic operations"
	@echo "  make quick && make test  # Quick build then test"
	@echo "  make all             # Build everything"
