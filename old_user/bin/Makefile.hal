# Makefile for HAL 9P Server

CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -D_GNU_SOURCE -pthread
LDFLAGS = -pthread

TARGET = hal-9p-server
SRCS = hal-9p-server.c
OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $<

clean:
	rm -f $(TARGET) $(OBJS)

test: $(TARGET)
	@echo "Starting HAL 9P server..."
	./$(TARGET)

.PHONY: all clean test
