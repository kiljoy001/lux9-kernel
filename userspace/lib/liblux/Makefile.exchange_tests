# Makefile for exchange pool tests
CC=gcc
CFLAGS=-I. -Iinc -I../../../kernel/include -I../../../include -D_LOCK_H_ -fPIC -Wall -Wextra -nostdlib -ffreestanding
LDFLAGS=-L.

# Default target
all: test_exchange test_exchange_suite

# Simple test
test_exchange: test_exchange.c liblux.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o test_exchange test_exchange.c -llux

# Comprehensive test suite
test_exchange_suite: test_exchange_suite.c liblux.a
	$(CC) $(CFLAGS) $(LDFLAGS) -o test_exchange_suite test_exchange_suite.c -llux

# Library dependency
liblux.a:
	$(MAKE) -C . liblux.a

# Clean up
clean:
	rm -f test_exchange test_exchange_suite

.PHONY: all clean