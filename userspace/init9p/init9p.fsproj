<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Kernel needs raw IL, not single-file bundled -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Use specific assembly name for initrd -->
    <AssemblyName>init</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Init.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../kernel/clr/bcl/src/System.Runtime/System.Runtime.csproj" />
  </ItemGroup>

</Project>
