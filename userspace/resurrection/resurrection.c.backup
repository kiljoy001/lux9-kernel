#ifndef UNIT_TEST
int main(void) {
  print("RESURRECTION: ============================================\n");
  print("RESURRECTION: === RESURRECTION SERVER STARTING ===\n");
  print("RESURRECTION: ============================================\n");
  print("RESURRECTION: About to call srv_setup...\n");

  /* Start 9P /srv server for service management */
  print("RESURRECTION: Setting up /srv 9P server...\n");
  srv_setup();

  print("RESURRECTION: /srv setup completed, about to start services...\n");

  /* Start managed services */
  print("RESURRECTION: ============================================\n");
  print("RESURRECTION: === STARTING MANAGED SERVICES ===\n");
  print("RESURRECTION: ============================================\n");

  print("RESURRECTION: About to start procd service...\n");
  start_procd_service();
  print("RESURRECTION: procd start completed\n");

  print("RESURRECTION: About to start HAL service...\n");
  start_hal_service();
  print("RESURRECTION: HAL start completed\n");

  print("RESURRECTION: About to start Sophia service...\n");
  start_sophia_service();
  print("RESURRECTION: Sophia start completed\n");

  print("RESURRECTION: ============================================\n");
  print("RESURRECTION: === ALL SERVICES STARTED ===\n");
  print("RESURRECTION: ============================================\n");
  print("RESURRECTION: === STARTING MANAGED SERVICES ===\n");
  print("RESURRECTION: ============================================\n");

  print("RESURRECTION: About to start procd service...\n");
  start_procd_service();
  print("RESURRECTION: procd start completed\n");

  print("RESURRECTION: About to start HAL service...\n");
  start_hal_service();
  print("RESURRECTION: HAL start completed\n");

  print("RESURRECTION: About to start Sophia service...\n");
  start_sophia_service();
  print("RESURRECTION: Sophia start completed\n");

  print("RESURRECTION: ============================================\n");
  print("RESURRECTION: === ALL SERVICES STARTED ===\n");
  print("RESURRECTION: ============================================\n");

  /* Spawn distress signal monitoring thread */
  int distress_pid = sys_rfork(RFPROC | RFMEM);
  if (distress_pid < 0) {
    print("RESURRECTION: Distress monitor rfork failed\n");
  } else if (distress_pid == 0) {
    /* Child: Distress signal monitoring loop */
    distress_loop();
    /* Should not return */
    return 0;
  } else {
    print("RESURRECTION: Distress monitor started\n");
  }

  /* Enter service monitoring loop */
  print("RESURRECTION: entering service monitor loop\n");
  monitor_services();

  /* ... shutdown ... */
}
#endif
