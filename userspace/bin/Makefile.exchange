# Makefile for HAL Exchange Server and Test Client

CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -D_GNU_SOURCE -g -O2
LDFLAGS =

TARGETS = hal-exchange-server hal-exchange-client-test

all: $(TARGETS)

hal-exchange-server: hal-exchange-server.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

hal-exchange-client-test: hal-exchange-client-test.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

clean:
	rm -f $(TARGETS) *.o

# Note: For testing, you need to create a way for server and client to share memory
# Option 1: Use shared memory file
# Option 2: Link both into single test program with threads
# Option 3: Use actual kernel Exchange API when running on Lux9

test:
	@echo "To test:"
	@echo "  Terminal 1: ./hal-exchange-server"
	@echo "  Terminal 2: ./hal-exchange-client-test"
	@echo ""
	@echo "Note: Current implementation uses global variable"
	@echo "      Both must be in same process for testing"

.PHONY: all clean test
